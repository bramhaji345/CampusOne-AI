# ==============================================================================
# CampusOne-AI Backend Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# For production serverless deployments (Neon, Supabase, AWS RDS with PgBouncer),
# append: ?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@hostname:5432/campusone?schema=public

# JSON Web Token Secret (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-at-least-32-chars

# Port for local development
PORT=5000

# Strict CORS Allowlist
# Primary production frontend URL (e.g., https://campusone.edu or https://campusone.vercel.app)
FRONTEND_URL=http://localhost:5173

# Optional additional frontend URL (e.g. staging or custom domain)
ADDITIONAL_FRONTEND_URL=

# Optional comma-separated list of additional allowed origins
# ALLOWED_ORIGINS=https://app.campusone.edu,https://admin.campusone.edu

# Optional Vercel Project Name for preview deployment validation
# VERCEL_PROJECT_NAME=campusone-ai

# Vercel Blob Object Storage Token (optional, for persistent cloud file uploads)
# Generate from Vercel Dashboard -> Storage -> Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
