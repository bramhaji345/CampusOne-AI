generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-v2"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  faculty
  admin
}

enum UserStatus {
  active
  inactive
}

enum ClassType {
  lecture
  lab
}

enum AttendanceStatus {
  present
  absent
}

enum ResultType {
  sem
  mid
}

enum OutpassType {
  urgent
  medical
  event
  personal
  other
}

enum OutpassStatus {
  pending
  approved
  rejected
}

enum CertificateStatus {
  pending
  approved
  rejected
}

enum NotificationPriority {
  normal
  important
  urgent
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  role      Role
  name      String
  photo     String?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  version   Int        @default(1)

  student            Student?
  faculty            Faculty?
  admin              Admin?
  sentNotifications  Notification[] @relation("NotificationSender")
  targetedNotifs     Notification[] @relation("NotificationTarget")
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]

  @@index([role, email])
  @@map("users")
}

model Admin {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Department {
  id      String    @id @default(uuid())
  name    String    @unique
  code    String    @unique
  courses Course[]
  faculty Faculty[]
  students Student[]
  subjects Subject[]
  branches Branch[]
  confirmationStatus String @default("CONFIRMED") @map("confirmation_status")
  sourceType String? @map("source_type")

  @@map("departments")
}

model Course {
  id           String     @id @default(uuid())
  name         String
  code         String
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  batches      Batch[]
  students     Student[]
  programId    String? @map("program_id")
  program      AcademicProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@unique([code, departmentId])
  @@map("courses")
}

model Batch {
  id        String  @id @default(uuid())
  name      String
  yearLevel String  @map("year_level")
  courseId  String  @map("course_id")
  course    Course  @relation(fields: [courseId], references: [id])
  classes   Class[]

  @@index([yearLevel])
  @@map("batches")
}

model Class {
  id              String           @id @default(uuid())
  section         String
  batchId         String           @map("batch_id")
  batch           Batch            @relation(fields: [batchId], references: [id])
  students        Student[]
  facultySubjects FacultySubject[]
  timetable       Timetable[]
  assignments     Assignment[]

  @@unique([batchId, section])
  @@map("classes")
}

model Subject {
  id              String           @id @default(uuid())
  name            String
  code            String
  departmentId    String           @map("department_id")
  department      Department       @relation(fields: [departmentId], references: [id])
  entryLevel      String?          @map("entry_level")
  semester        String?
  category        String?
  ltp             String?
  credits         Float?
  sourceDocument  String?          @map("source_document")
  curriculumScope String?          @map("curriculum_scope")
  sourceType      String?          @map("source_type")
  confirmationStatus String @default("CONFIRMED") @map("confirmation_status")
  facultySubjects FacultySubject[]
  courseRecords   StudentCourseRecord[]
  courseAssignments FacultyCourseAssignment[]
  offerings       SubjectOffering[]
  attendance      Attendance[]
  results         Result[]
  timetable       Timetable[]
  assignments     Assignment[]

  @@unique([code, departmentId])
  @@index([name])
  @@map("subjects")
}

model Student {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  studentId   String  @unique @map("student_id")
  dormNo      String? @map("dorm_no")
  year        Int
  parentName  String? @map("parent_name")
  mobile      String?
  parentPhone String? @map("parent_phone")
  section     String
  courseName  String  @map("course")
  deptCode    String  @map("dept")
  cgpa        Float   @default(0)
  active      Boolean  @default(true)
  version     Int      @default(1)
  sourceStatus String  @default("system-entered") @map("source_status")
  sourceSheet  String? @map("source_sheet")
  gender       String?
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  collegeId    String?  @unique @map("college_id")
  academicYear String?  @map("academic_year")
  academicStatus String? @map("academic_status")
  branchId     String?  @map("branch_id")
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rank         Int?
  pucCgpa      Float?   @map("puc_cgpa")
  academicBatchId String? @map("academic_batch_id")
  academicBatch AcademicBatch? @relation(fields: [academicBatchId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id])
  classId      String     @map("class_id")
  class        Class      @relation(fields: [classId], references: [id])

  attendance   Attendance[]
  results      Result[]
  cgpaRecords  SemesterCgpa[]
  submissions  AssignmentSubmission[]
  outpasses    Outpass[]
  certificates Certificate[]
  courseRecords StudentCourseRecord[]
  advisorMappings StudentAdvisor[]

  @@index([deptCode, section])
  @@index([studentId])
  @@map("students")
}

model Faculty {
  id           String  @id @default(uuid())
  userId       String  @unique @map("user_id")
  facultyId    String  @unique @map("faculty_id")
  designation  String
  mobile       String?
  subjectsText String  @default("") @map("subjects")
  deptCode     String  @map("dept")
  active       Boolean  @default(true)
  version      Int      @default(1)
  sourceStatus String   @default("system-entered") @map("source_status")
  sourceSheet  String?  @map("source_sheet")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  employeeId   String?  @unique @map("employee_id")
  gender       String?
  qualification String?
  specialization String?
  experienceYears Float? @map("experience_years")
  joiningDate  DateTime? @map("joining_date") @db.Date
  employmentType String? @map("employment_type")
  officeRoom   String? @map("office_room")
  campus       String?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])

  facultySubjects FacultySubject[]
  attendance      Attendance[]
  timetable       Timetable[]
  assignments     Assignment[]
  outpasses       Outpass[]
  courseAssignments FacultyCourseAssignment[]
  advisees         StudentAdvisor[]
  leaves           FacultyLeave[]

  @@index([facultyId])
  @@map("faculty")
}

model FacultySubject {
  id        String  @id @default(uuid())
  facultyId String  @map("faculty_id")
  subjectId String  @map("subject_id")
  classId   String  @map("class_id")
  faculty Faculty @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])
  class     Class   @relation(fields: [classId], references: [id])

  @@unique([facultyId, subjectId, classId])
  @@map("faculty_subjects")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  subjectId String           @map("subject_id")
  facultyId String           @map("faculty_id")
  subject   String
  classType ClassType        @map("class_type")
  date      String
  status    AttendanceStatus
  student    Student  @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  subjectRel Subject  @relation(fields: [subjectId], references: [id])
  faculty    Faculty  @relation(fields: [facultyId], references: [facultyId])

  @@unique([studentId, subjectId, date, classType])
  @@index([studentId, date])
  @@index([facultyId, date])
  @@map("attendance")
}

model Result {
  id          String     @id @default(uuid())
  studentId   String     @map("student_id")
  subjectId   String     @map("subject_id")
  yearLevel   String     @map("year_level")
  semester    String
  type        ResultType
  subject     String
  marks       Float
  maxMarks    Float      @default(100) @map("max_marks")
  grade       String
  gradePoints Float?     @map("grade_points")
  student    Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  subjectRel Subject @relation(fields: [subjectId], references: [id])

  @@index([studentId, yearLevel, semester, type])
  @@map("results")
}

model SemesterCgpa {
  id        String  @id @default(uuid())
  studentId String  @map("student_id")
  yearLevel String  @map("year_level")
  semester  String
  gpa       Float
  academicYear String? @map("academic_year")
  totalCredits Float? @map("total_credits")
  earnedCredits Float? @map("earned_credits")
  totalCreditPoints Float? @map("total_credit_points")
  cumulativeCredits Float? @map("cumulative_credits")
  cumulativeCreditPoints Float? @map("cumulative_credit_points")
  academicStatus String? @map("academic_status")
  sourceStatus String @default("system-entered") @map("source_status")
  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([studentId, yearLevel, semester])
  @@map("semester_cgpa")
}

model Timetable {
  id          String  @id @default(uuid())
  classId     String? @map("class_id")
  facultyId   String? @map("faculty_id")
  subjectId   String? @map("subject_id")
  roleOwner   String  @map("role_owner")
  ownerId     String  @map("owner_id")
  day         String
  period      Int
  subject     String
  room        String
  timeSlot    String  @map("time_slot")
  facultyName String? @map("faculty_name")
  classType   String? @map("class_type")
  class       Class?  @relation(fields: [classId], references: [id])
  faculty    Faculty? @relation(fields: [facultyId], references: [facultyId])
  subjectRel  Subject? @relation(fields: [subjectId], references: [id])

  @@index([roleOwner, ownerId, day])
  @@map("timetable")
}

model Assignment {
  id          String   @id @default(uuid())
  facultyId   String   @map("faculty_id")
  classId     String?  @map("class_id")
  subjectId   String?  @map("subject_id")
  title       String
  description String
  subject     String
  dueDate     String   @map("due_date")
  fileUrl     String?  @map("file_url")
  createdAt   DateTime @default(now()) @map("created_at")
  faculty    Faculty @relation(fields: [facultyId], references: [facultyId])
  class      Class?  @relation(fields: [classId], references: [id])
  subjectRel  Subject? @relation(fields: [subjectId], references: [id])
  submissions AssignmentSubmission[]

  @@index([facultyId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  studentId    String     @map("student_id")
  fileUrl      String?    @map("file_url")
  submittedAt  DateTime?  @map("submitted_at")
  status       String     @default("submitted")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model Notification {
  id         String                 @id @default(uuid())
  title      String
  body       String
  senderId   String?                @map("sender_id")
  targetRole String                 @map("target_role")
  targetId   String?                @map("target_id")
  priority   NotificationPriority   @default(normal)
  readBy     Json                   @default("[]") @map("read_by")
  createdAt  DateTime               @default(now()) @map("created_at")
  sender     User?                  @relation("NotificationSender", fields: [senderId], references: [id])
  targetUser User?                  @relation("NotificationTarget", fields: [targetId], references: [id])

  @@index([targetRole, targetId])
  @@map("notifications")
}

model Outpass {
  id          String        @id @default(uuid())
  studentId   String        @map("student_id")
  facultyId   String        @map("faculty_id")
  reason      String
  reasonType  OutpassType   @map("reason_type")
  fromDate    String        @map("from_date")
  toDate      String        @map("to_date")
  destination String?
  outTime     String?       @map("out_time")
  returnTime  String?       @map("return_time")
  extra       String?
  status      OutpassStatus @default(pending)
  qrCode      String?       @map("qr_code")
  scannedAt   DateTime?     @map("scanned_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  reviewedAt  DateTime?     @map("reviewed_at")
  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [facultyId])

  @@index([facultyId, status])
  @@index([studentId])
  @@map("outpasses")
}

model Certificate {
  id         String            @id @default(uuid())
  studentId  String            @map("student_id")
  type       String
  purpose    String
  status     CertificateStatus @default(pending)
  fileUrl    String?           @map("file_url")
  createdAt  DateTime          @default(now()) @map("created_at")
  reviewedAt DateTime?         @map("reviewed_at")
  student Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)

  @@index([status])
  @@map("certificates")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model SubjectOffering {
  id                 String   @id @default(uuid())
  subjectId          String   @map("subject_id")
  entryLevel         String   @map("entry_level")
  semester           String
  category           String
  ltp                String?
  credits            Float?
  sourceDocument     String?  @map("source_document")
  sourceType         String?  @map("source_type")
  curriculumScope    String?  @map("curriculum_scope")
  confirmationStatus String   @default("CONFIRMED") @map("confirmation_status")
  sourceStatus       String   @default("workbook-source") @map("source_status")
  subject            Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, entryLevel, semester, category])
  @@index([entryLevel, semester])
  @@map("subject_offerings")
}

model StudentCourseRecord {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  subjectId       String   @map("subject_id")
  semester        String
  academicYear    String   @map("academic_year")
  credits         Float?
  marks           Float?
  grade           String?
  gradePoint      Float?   @map("grade_point")
  creditPoints    Float?   @map("credit_points")
  resultStatus    String?  @map("result_status")
  curriculumScope String?  @map("curriculum_scope")
  sourceStatus    String   @default("system-entered") @map("source_status")
  student         Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  subject         Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, semester, academicYear])
  @@index([studentId, academicYear, semester])
  @@map("student_course_records")
}

model FacultyCourseAssignment {
  id             String   @id @default(uuid())
  facultyId      String   @map("faculty_id")
  subjectId      String   @map("subject_id")
  academicYear   String   @map("academic_year")
  semester       String
  role           String?
  status         String   @default("ACTIVE")
  curriculumNote String?  @map("curriculum_note")
  sourceStatus   String   @default("system-entered") @map("source_status")
  faculty        Faculty @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)
  subject        Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([facultyId, subjectId, academicYear, semester])
  @@index([subjectId, academicYear, semester])
  @@map("faculty_course_assignments")
}

model StudentAdvisor {
  id           String  @id @default(uuid())
  studentId    String  @map("student_id")
  facultyId    String  @map("faculty_id")
  academicYear String  @map("academic_year")
  status       String  @default("ACTIVE")
  sourceStatus String  @default("system-entered") @map("source_status")
  student      Student @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  faculty      Faculty @relation(fields: [facultyId], references: [facultyId], onDelete: Restrict)

  @@unique([studentId, academicYear])
  @@index([facultyId, academicYear])
  @@map("student_advisors")
}

model FacultyLeave {
  id             String    @id
  facultyId      String    @map("faculty_id")
  leaveType      String    @map("leave_type")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  days           Float?
  approvalStatus String    @map("approval_status")
  academicYear   String?   @map("academic_year")
  sourceStatus   String    @default("system-entered") @map("source_status")
  faculty        Faculty   @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)

  @@index([facultyId, startDate])
  @@map("faculty_leaves")
}

model Branch {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  departmentId       String   @map("department_id")
  confirmationStatus String   @default("CONFIRMED") @map("confirmation_status")
  sourceType         String?  @map("source_type")
  department         Department @relation(fields: [departmentId], references: [id])
  students           Student[]

  @@index([departmentId])
  @@map("branches")
}

model AcademicProgram {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  durationYears Int?    @map("duration_years")
  totalCredits  Float?  @map("total_credits")
  sourceType    String? @map("source_type")
  courses       Course[]
  @@map("academic_programs")
}

model AcademicBatch {
  id           String  @id @default(uuid())
  name         String  @unique
  description  String?
  sourceType   String? @map("source_type")
  syntheticUse String? @map("synthetic_use")
  startYear    Int?    @map("start_year")
  endYear      Int?    @map("end_year")
  students     Student[]
  @@map("academic_batches")
}

model GradeScale {
  id           String  @id @default(uuid())
  grade        String  @unique
  minimumMarks Float?  @map("minimum_marks")
  maximumMarks Float?  @map("maximum_marks")
  gradePoint   Float?  @map("grade_point")
  resultStatus String? @map("result_status")
  @@map("grade_scales")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  requestInfo String?  @map("request_info")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
